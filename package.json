{
  "name": "scoped-mcp-on-aws",
  "version": "1.0.0",
  "description": "Per-tool OAuth scopes for a remote MCP server on AWS Lambda, API Gateway and Amazon Cognito",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth",
    "deploy": "cdk deploy --outputs-file cdk-outputs.json",
    "destroy": "cdk destroy",
    "token": "tsx scripts/token.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "license": "MIT-0",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1166.0",
    "@aws-sdk/lib-dynamodb": "^3.1166.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1166.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1166.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "aws-cdk": "^2.1148.0",
    "aws-cdk-lib": "^2.276.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
